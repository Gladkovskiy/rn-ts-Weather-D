<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@color/backgroundNavigationColor</item>
        <item name="android:statusBarColor">@color/backgroundStatusBarColor</item>
        <!-- Customize your theme here. -->
        <item name="android:windowDisablePreview">true</item> <!--this is the line you need to add to fix white flash-->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <style name="SplashScreenTheme" parent="SplashScreen_SplashTheme">
        <item name="colorPrimaryDark">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
    </style>
</resources>
